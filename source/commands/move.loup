@mode(host.dual)

# move: moves files (a wildcard source moves every matching file) into a
# directory or to a new name, and moves or renames one directory.
#
# Runtime: host.dual. Compiled into the native binary build/move by
# `make build`; `loup run source/main.loup` interprets the same code. Natively
# the io.fs calls fail silently and Stage0 throws, so every step is checked on
# disk afterwards. Renames go through runtime.fs().rename: io.fs's `rename`
# aborts native builds.
#
# Structure: plan_move() turns the two operands into a Plan (the renames to
# make, or the message that stops the command) without changing anything;
# move_file(), move_dir() and copy_then_remove() carry out one Step and report
# whether it is done; run_move() asks before overwriting, carries out the Plan
# and is the only function that prints.

from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.args import (Options, should_ask);
from commands.cwd import (absolute_path, current_dir);
from commands.prompt import (ANSWER_ALL, ANSWER_YES, ask_overwrite);
from io.fs import (copy, exists, isDir, isFile, readBytes, remove);
from win.messages import (MSG_ACCESS_DENIED, MSG_FILE_NOT_FOUND, MSG_INVALID_NAME, MSG_PATH_NOT_FOUND,
    MSG_SYNTAX);
from win.paths import (base_name, display_path, fs_path, join_path, parent_dir, strip_trailing_separators);
from win.wildcard import (MATCH_FILES, expand, has_wildcards, wildcard_in_directory);

pub const MSG_MULTIPLE_TO_ONE: string = "Cannot move multiple files to a single file.";
pub const MSG_FILE_EXISTS: string = "Cannot create a file when that file already exists.";

# One rename: `src` to `dst`, both in fs form.
pub struct Step {
    pub src: string;
    pub dst: string;
    pub is_dir: bool;
}

func make_step(src: string, dst: string, is_dir: bool): Step {
    return Step(src = src, dst = dst, is_dir = is_dir);
}

# What a command line asks for.
pub struct Plan {
    pub steps: list[Step];
    pub error: string;        # "" or the message that stops the command
    pub show_names: bool;     # a wildcard source: print each file moved
}

func make_plan(steps: list[Step], show_names: bool): Plan {
    return Plan(steps = steps, error = "", show_names = show_names);
}

func plan_error(message: string): Plan {
    let none: list[Step] = [];
    return Plan(steps = none, error = message, show_names = false);
}

# Plans `move SOURCE DEST`. `cwd` (absolute, or "" if unknown) is used to
# refuse moving a directory into itself.
pub func plan_move(source: string, dest: string, cwd: string): Plan {
    if (wildcard_in_directory(source) or has_wildcards(dest)) {
        return plan_error(MSG_INVALID_NAME);
    }
    # The sources: the files a wildcard matches, or one file or directory.
    let wild = has_wildcards(source);
    var sources: list[string] = [];
    var src_is_dir = false;
    if (wild) {
        sources = expand(source, MATCH_FILES);
        if (sources.len() == 0) {
            return plan_error(MSG_FILE_NOT_FOUND);
        }
    } else {
        let p = strip_trailing_separators(fs_path(source));
        if (isDir(p)) {
            src_is_dir = true;
            sources.push(p);
        } else if (isFile(p)) {
            sources.push(p);
        } else {
            let parent = parent_dir(p);
            if (parent.len() > 0 and !isDir(parent)) {
                return plan_error(MSG_PATH_NOT_FOUND);
            }
            return plan_error(MSG_FILE_NOT_FOUND);
        }
    }

    # The destination: an existing directory takes every source under its
    # own name; anything else is the new name of the single source.
    let d = fs_path(dest);
    let target = strip_trailing_separators(d);
    if (target.len() == 0) {
        return plan_error(MSG_INVALID_NAME);
    }
    var steps: list[Step] = [];
    if (isDir(target)) {
        for (s in sources) {
            steps.push(make_step(s, join_path(target, base_name(s)), src_is_dir));
        }
    } else {
        if (sources.len() > 1) {
            return plan_error(MSG_MULTIPLE_TO_ONE);
        }
        let parent = parent_dir(target);
        if (d.len() > target.len() or (parent.len() > 0 and !isDir(parent))) {
            return plan_error(MSG_PATH_NOT_FOUND);
        }
        if (src_is_dir and exists(target)) {
            return plan_error(MSG_FILE_EXISTS);
        }
        steps.push(make_step(sources[0], target, src_is_dir));
    }

    # A directory cannot move into itself or below itself.
    if (src_is_dir) {
        let origin = absolute_path(steps[0].src, cwd);
        let to = absolute_path(steps[0].dst, cwd);
        if (to == origin or to.startsWith(origin + "/")) {
            return plan_error(MSG_ACCESS_DENIED);
        }
    }
    return make_plan(steps, wild);
}

# The rename, ignoring the exception Stage0 throws on failure (native builds
# fail silently); callers check the result on disk.
func try_rename(src: string, dst: string): void {
    try {
        runtime.fs().rename(src, dst);
    } catch (Exception as e) {
    }
}

func try_copy(src: string, dst: string): void {
    try {
        copy(src, dst);
    } catch (Exception as e) {
    }
}

func try_remove(path: string): void {
    try {
        remove(path);
    } catch (Exception as e) {
    }
}

# The fallback when a rename fails (another file system): copy, check the
# copy's size, then remove the source. Gives up, leaving the source, if any
# step fails.
pub func copy_then_remove(src: string, dst: string): bool {
    if (!isFile(src)) {
        return false;
    }
    if (isFile(dst)) {
        try_remove(dst);
        if (isFile(dst)) {
            return false;
        }
    }
    try_copy(src, dst);
    if (!isFile(dst) or readBytes(dst).len() != readBytes(src).len()) {
        return false;
    }
    try_remove(src);
    if (exists(src)) {
        try_remove(dst);
        return false;
    }
    return true;
}

# Moves one file, replacing `dst`; true when it is done.
pub func move_file(src: string, dst: string): bool {
    try_rename(src, dst);
    if (!exists(src) and isFile(dst)) {
        return true;
    }
    return copy_then_remove(src, dst);
}

# Moves or renames a directory (a rename only, as on Windows: directories
# do not move across file systems).
pub func move_dir(src: string, dst: string): bool {
    try_rename(src, dst);
    return !exists(src) and isDir(dst);
}

func pad_left(text: string, width: int): string {
    var parts: list[string] = [];
    for (i in text.len()..width) {
        parts.push(" ");
    }
    parts.push(text);
    return parts.join("");
}

# `        2 file(s) moved.`, or `dir(s)` for a directory.
pub func summary_line(count: int, dirs: bool): string {
    let what = if (dirs) { " dir(s) moved." } else { " file(s) moved." };
    return pad_left(str(count), 9) + what;
}

pub func run_move(opts: Options): int {
    if (opts.operands.len() != 2) {
        printErr(MSG_SYNTAX);
        return EXIT_FAILURE;
    }
    let cwd = current_dir();
    let plan = plan_move(opts.operands[0], opts.operands[1], cwd);
    if (plan.error.len() > 0) {
        printErr(plan.error);
        return EXIT_FAILURE;
    }
    var ask = should_ask(opts.confirm, env("COPYCMD") ?? "");
    var moved = 0;
    var dirs = false;
    var status = EXIT_OK;
    for (step in plan.steps) {
        if (plan.show_names) {
            println(display_path(absolute_path(step.src, cwd)));
        }
        if (step.is_dir) {
            dirs = true;
            if (move_dir(step.src, step.dst)) {
                moved += 1;
            } else {
                printErr(MSG_ACCESS_DENIED);
                status = EXIT_FAILURE;
            }
            continue;
        }
        if (absolute_path(step.src, cwd) == absolute_path(step.dst, cwd)) {
            moved += 1;
            continue;
        }
        if (isDir(step.dst)) {
            printErr(MSG_ACCESS_DENIED);
            status = EXIT_FAILURE;
            continue;
        }
        if (ask and isFile(step.dst)) {
            let answer = ask_overwrite(display_path(absolute_path(step.dst, cwd)));
            if (answer == ANSWER_ALL) {
                ask = false;
            } else if (answer != ANSWER_YES) {
                continue;
            }
        }
        if (move_file(step.src, step.dst)) {
            moved += 1;
        } else {
            printErr(MSG_ACCESS_DENIED);
            status = EXIT_FAILURE;
        }
    }
    println(summary_line(moved, dirs));
    return status;
}
