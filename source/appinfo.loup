@mode(host.dual)

# Application identity of move: name, version, one-line summary and exit
# statuses. Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/move by
# `make build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "move";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Move files and rename directories (a Loup recreation of the Windows move command).";

# Exit statuses returned by main(). Like cmd.exe's move, a usage error is
# ERRORLEVEL 1, the same as any other failure.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
