@mode(host.dual)

# Help and version text of move: what `move /?` prints (a short summary of
# this recreation's syntax and switches) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/move by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `move /?`: a short summary of this recreation's syntax and
# switches.
pub func usage(): string {
    let lines = [
        "Move files to another directory or name, or rename a directory.",
        "",
        "MOVE [/Y | /-Y] source destination",
        "",
        "  source       A file, a pattern with * and ? (matching files), or a directory.",
        "  destination  An existing directory to move into, or a new name.",
        "  /Y           Replace existing files without asking.",
        "  /-Y          Ask before replacing an existing file.",
        "",
        "Without /Y or /-Y, move asks, unless the COPYCMD variable contains /Y.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
