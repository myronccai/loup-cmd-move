@mode(host.dual)

# Command-line parsing for move, with the shared Windows switch parser
# (win/switches.loup). A `/X` that is not /Y or /-Y is a path.

from win.switches import (SwitchSpec, flag, parse_switches, switch_error_message);

# Whether to ask before overwriting a file: not said on the command line
# (the COPYCMD variable or the default decides), /-Y, or /Y.
pub const CONFIRM_DEFAULT: int = 0;
pub const CONFIRM_ASK: int = 1;
pub const CONFIRM_NEVER: int = 2;

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub confirm: int;            # CONFIRM_DEFAULT, CONFIRM_ASK (/-Y) or CONFIRM_NEVER (/Y)
    pub operands: list[string];
}

pub func move_switches(): list[SwitchSpec] {
    return [flag("Y"), flag("-Y")];
}

# The confirm setting a list of switches ends with: the last /Y or /-Y wins.
func confirm_from(names: list[string], start: int): int {
    var confirm = start;
    for (name in names) {
        if (name == "Y") {
            confirm = CONFIRM_NEVER;
        } else if (name == "-Y") {
            confirm = CONFIRM_ASK;
        }
    }
    return confirm;
}

# The confirm setting of a COPYCMD value such as "/Y" or "/-y".
pub func copycmd_confirm(value: string): int {
    var names: list[string] = [];
    for (word in value.split(" ")) {
        let w = word.trim().toUpperCase();
        if (w == "/Y" or w == "-Y") {
            names.push("Y");
        } else if (w == "/-Y" or w == "--Y") {
            names.push("-Y");
        }
    }
    return confirm_from(names, CONFIRM_DEFAULT);
}

# Whether to ask before overwriting: the command line wins, then COPYCMD;
# by default move asks, as it does at the cmd prompt.
pub func should_ask(confirm: int, copycmd: string): bool {
    if (confirm != CONFIRM_DEFAULT) {
        return confirm == CONFIRM_ASK;
    }
    return copycmd_confirm(copycmd) != CONFIRM_NEVER;
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, move_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };
    var names: list[string] = [];
    for (sw in parsed.switches) {
        names.push(sw.name);
    }
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        confirm = confirm_from(names, CONFIRM_DEFAULT),
        operands = parsed.operands,
    ));
}
