@mode(host.dual)

# Unit tests for move's whole command line (cli.app.run): exit statuses for
# help, version, a wrong number of operands, and a real move under build/tmp/.
# These tests print the program's normal output and error messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from io.fs import (createDir, writeText, removeDir, isDir, isFile);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_wrong_operand_count_fails(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_FAILURE, "no operands");
    expectEq(run(["a", "b", "c"]), EXIT_FAILURE, "three operands");
}

func test_move(): void {
    let root = "build/tmp/app_move";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root + "/sub");
    writeText(root + "/t.txt", "tests pass\n");
    writeText(root + "/sub/t.txt", "old\n");
    expectEq(run(["/Y", root + "\\t.txt", root + "\\sub"]), EXIT_OK, "overwrite without asking");
    expect(!isFile(root + "/t.txt") and isFile(root + "/sub/t.txt"), "moved");
    expectEq(run([root + "/t.txt", root + "/sub"]), EXIT_FAILURE, "source gone");
    removeDir(root);
}
