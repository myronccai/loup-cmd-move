@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, copycmd_confirm, should_ask, CONFIRM_DEFAULT, CONFIRM_ASK, CONFIRM_NEVER);

func test_operands(): void {
    let opts = parse_args(["a.txt", "sub\\"]).unwrap();
    expectEq(opts.operands.join(","), "a.txt,sub\\", "operands");
    expectEq(opts.confirm, CONFIRM_DEFAULT, "nothing said");
}

func test_confirm_switches(): void {
    expectEq(parse_args(["/Y", "a", "b"]).unwrap().confirm, CONFIRM_NEVER, "/Y");
    expectEq(parse_args(["a", "-y", "b"]).unwrap().confirm, CONFIRM_NEVER, "-y");
    expectEq(parse_args(["/-Y", "a", "b"]).unwrap().confirm, CONFIRM_ASK, "/-Y");
    expectEq(parse_args(["/Y", "/-y", "a", "b"]).unwrap().confirm, CONFIRM_ASK, "last one wins");
}

func test_paths_that_look_like_switches(): void {
    let opts = parse_args(["/tmp/a", "/yes", "-x"]).unwrap();
    expectEq(opts.operands.len(), 3, "all operands");
}

func test_copycmd(): void {
    expectEq(copycmd_confirm(""), CONFIRM_DEFAULT, "empty");
    expectEq(copycmd_confirm("/Y"), CONFIRM_NEVER, "/Y");
    expectEq(copycmd_confirm("/v /-y"), CONFIRM_ASK, "/-y among others");
}

func test_should_ask(): void {
    expect(should_ask(CONFIRM_DEFAULT, ""), "asks by default");
    expect(!should_ask(CONFIRM_DEFAULT, "/Y"), "COPYCMD=/Y");
    expect(should_ask(CONFIRM_ASK, "/Y"), "/-Y beats COPYCMD");
    expect(!should_ask(CONFIRM_NEVER, "/-Y"), "/Y beats COPYCMD");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["a", "-?"]).unwrap().help, "-?");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["--", "/?"]).unwrap().help, "/? after --");
}
